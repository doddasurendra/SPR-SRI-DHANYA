# Gateway Mode: "test" for Sandbox testing, "live" for Real Bank Account Settlement
RAZORPAY_MODE=test

# Razorpay Test / Sandbox Credentials (Get from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_TEST_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_TEST_KEY_SECRET=YourTestKeySecretHere

# Razorpay Live Production Credentials (ENABLE ONLY AFTER MERCHANT ACTIVATION APPROVAL)
RAZORPAY_LIVE_KEY_ID=rzp_live_YourLiveKeyIdHere
RAZORPAY_LIVE_KEY_SECRET=YourLiveKeySecretHere

# Razorpay Webhook Secret (Set up in dashboard.razorpay.com -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Server Configuration
PORT=8000
HOST=0.0.0.0

